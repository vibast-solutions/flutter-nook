# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/

# The app's lock file is committed so CI resolves the same dependency versions
# the app was tested against; packages/ are libraries, whose locks are not.
packages/*/pubspec.lock
*.iml
.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Platform build output
android/.gradle/
android/local.properties
android/key.properties
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# Secrets — never commit
*.jks
*.keystore
.env
.env.*
!.env.dist
