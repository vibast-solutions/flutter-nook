  "starsSubtitle": "One star in every row, column and region",
  "@starsSubtitle": { "description": "The one-line description of Stars in the home game list." },
  "starsInstruction": "Tap once to rule out, twice for a star",
  "@starsInstruction": { "description": "The single line of instruction under the Stars board: a tap cycles a cell from empty, to a ruled-out dot, to a star, and back." },
