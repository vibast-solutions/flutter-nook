    "description": "The running count above the Stars board: how many stars are placed out of how many a finished board holds. A star icon sits before it.",
    "placeholders": {
      "placed": { "type": "int", "example": "3" },
      "target": { "type": "int", "example": "8" }
    }
  },
  "starsCounterLabel": "{placed} of {target} stars placed",
  "@starsCounterLabel": {
    "description": "Screen-reader label for the star counter above the board.",
    "placeholders": {
      "placed": { "type": "int", "example": "3" },
      "target": { "type": "int", "example": "8" }
    }
  },
  "starsLegend": "Each region has its own colour",
  "@starsLegend": { "description": "The caption under the legend below the Stars board, naming what the eight colour swatches are." },
  "starsLegendLabel": "The regions, each in its own colour",
  "@starsLegendLabel": { "description": "Screen-reader label for the legend of region swatches below the Stars board." },
  "duoTitle": "Duo",
