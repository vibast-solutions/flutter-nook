{
  "@@locale": "en",

  "appTitle": "Nook",
  "@appTitle": {
    "description": "The name of the app, shown in the task switcher and as the wordmark on the home screen. A brand name: leave it untranslated."
  },

  "homeAllGames": "ALL GAMES",
  "@homeAllGames": {
    "description": "Heading above the list of games on the home screen. Upper case in English by design; use whatever the language's convention for a small section heading is."
  },
  "homeContinue": "CONTINUE",
  "@homeContinue": {
    "description": "Heading above the card offering the puzzle the player last left unfinished, at the top of the home screen. Upper case in English by design; use whatever the language's convention for a small section heading is."
  },
  "continueDetails": "{difficulty} · {time} · {percent}% filled in",
  "@continueDetails": {
    "description": "The second line of a card offering an unfinished puzzle: how hard it is, how long it has been played for, and how much of the grid has something written in it.",
    "placeholders": {
      "difficulty": { "type": "String", "example": "Medium" },
      "time": { "type": "String", "example": "07:42" },
      "percent": { "type": "int", "example": "45" }
    }
  },
  "continueProgress": "{time} · {percent}% filled in",
  "@continueProgress": {
    "description": "The line on the in-progress card on a game's own screen, where the game is already named above: how long the puzzle has been played for, and how much of the grid has something written in it.",
    "placeholders": {
      "time": { "type": "String", "example": "07:42" },
      "percent": { "type": "int", "example": "45" }
    }
  },
  "continueLabel": "Continue {game}, {difficulty}, {time} played, {percent}% filled in",
  "@continueLabel": {
    "description": "Screen-reader label for the card offering an unfinished puzzle.",
    "placeholders": {
      "game": { "type": "String", "example": "Sudoku Classic" },
      "difficulty": { "type": "String", "example": "Medium" },
      "time": { "type": "String", "example": "07:42" },
      "percent": { "type": "int", "example": "45" }
    }
  },
  "homePromise": "No ads. No tracking. No account. Ever.",
  "@homePromise": {
    "description": "The footer of the home screen. Nook's central promise, so keep it short and flat rather than enthusiastic."
  },
  "homeDaily": "TODAY'S PUZZLE",
  "@homeDaily": {
    "description": "Heading above the daily-puzzle card on the home screen — the one puzzle that is the same for every player on a given day. Upper case in English by design; use whatever the language's convention for a small section heading is."
  },
  "dailyDetails": "{date} · {difficulty}",
  "@dailyDetails": {
    "description": "The second line of the daily-puzzle card before it has been started: which day this is the puzzle of, and how hard the day makes it.",
    "placeholders": {
      "date": { "type": "DateTime", "format": "MMMEd" },
      "difficulty": { "type": "String", "example": "Medium" }
    }
  },
  "dailyDetailsProgress": "{date} · {time} · {percent}% filled in",
  "@dailyDetailsProgress": {
    "description": "The second line of the daily-puzzle card while today's puzzle is under way: the day, how long it has been played for, and how far along it is.",
    "placeholders": {
      "date": { "type": "DateTime", "format": "MMMEd" },
      "time": { "type": "String", "example": "07:42" },
      "percent": { "type": "int", "example": "45" }
    }
  },
  "dailyLabel": "Today's puzzle: {game}, {date}, {difficulty}. Not started yet. {streak, plural, =0{No daily streak yet} =1{Daily streak, 1 day} other{Daily streak, {streak} days}}",
  "@dailyLabel": {
    "description": "Screen-reader label for the daily-puzzle card before it has been started. One sentence, ending with the daily streak the card also shows.",
    "placeholders": {
      "game": { "type": "String", "example": "Sudoku Classic" },
      "date": { "type": "DateTime", "format": "MMMEd" },
      "difficulty": { "type": "String", "example": "Medium" },
      "streak": { "type": "int", "example": "5" }
    }
  },
  "dailyLabelProgress": "Continue today's puzzle: {game}, {date}, {time} played, {percent}% filled in. {streak, plural, =0{No daily streak yet} =1{Daily streak, 1 day} other{Daily streak, {streak} days}}",
  "@dailyLabelProgress": {
    "description": "Screen-reader label for the daily-puzzle card while today's puzzle is under way. One sentence, ending with the daily streak the card also shows.",
    "placeholders": {
      "game": { "type": "String", "example": "Sudoku Classic" },
      "date": { "type": "DateTime", "format": "MMMEd" },
      "time": { "type": "String", "example": "07:42" },
      "percent": { "type": "int", "example": "45" },
      "streak": { "type": "int", "example": "5" }
    }
  },
  "dailySolvedDetails": "{date} · Solved",
  "@dailySolvedDetails": {
    "description": "The second line of the daily-puzzle card once today's puzzle has been solved: the day, and that it is done. The card is no longer tappable in this state.",
    "placeholders": {
      "date": { "type": "DateTime", "format": "MMMEd" }
    }
  },
  "dailyLabelSolved": "Today's puzzle solved: {game}, {date}. {streak, plural, =0{No daily streak yet} =1{Daily streak, 1 day} other{Daily streak, {streak} days}}",
  "@dailyLabelSolved": {
    "description": "Screen-reader label for the daily-puzzle card once today's puzzle is solved. One sentence, ending with the daily streak the card also shows.",
    "placeholders": {
      "game": { "type": "String", "example": "Sudoku Classic" },
      "date": { "type": "DateTime", "format": "MMMEd" },
      "streak": { "type": "int", "example": "5" }
    }
  },
  "gameRowLabel": "{title}. {subtitle}",
  "@gameRowLabel": {
    "description": "Screen-reader label for a playable game in the home list.",
    "placeholders": {
      "title": { "type": "String", "example": "Sudoku Classic" },
      "subtitle": { "type": "String", "example": "9x9 · the full grid" }
    }
  },
  "gameRowUnavailableLabel": "{title}. Not available yet",
  "@gameRowUnavailableLabel": {
    "description": "Screen-reader label for a game in the home list that is listed but cannot be played yet.",
    "placeholders": {
      "title": { "type": "String", "example": "Stars" }
    }
  },
  "gameRowSubtitle": "{size} · {description}",
  "@gameRowSubtitle": {
    "description": "The second line of a Sudoku row on the home screen: the grid size, then what the grid feels like.",
    "placeholders": {
      "size": { "type": "String", "example": "9x9" },
      "description": { "type": "String", "example": "the full grid" }
    }
  },

  "sudokuClassicTitle": "Sudoku Classic",
  "@sudokuClassicTitle": { "description": "Name of the 9x9 Sudoku." },
  "sudokuLightTitle": "Sudoku Light",
  "@sudokuLightTitle": { "description": "Name of the 6x6 Sudoku." },
  "sudokuMiniTitle": "Sudoku Mini",
  "@sudokuMiniTitle": { "description": "Name of the 4x4 Sudoku." },

  "sudokuClassicBlurb": "the full grid",
